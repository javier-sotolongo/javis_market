# =============================================================================
# PLANTILLA de Nginx para Javis Market (no instalada en ningún servidor).
#
# Marcadores pendientes:
#   <DOMAIN>              dominio facilitado por Marco (pendiente)
#   <APP_PORT>            puerto interno de Next.js (PORT en el archivo de entorno)
#   <STORAGE_PUBLIC_DIR>  directorio persistente de imágenes públicas, fuera del repositorio
#   <CERT_PATH>/<KEY_PATH> certificado TLS (p. ej. emitido con Certbot)
#
# STORAGE_PRIVATE_DIR no aparece aquí a propósito: los documentos privados nunca
# los sirve Nginx; solo la aplicación, tras comprobar permisos.
# =============================================================================

upstream javis_web {
    server 127.0.0.1:<APP_PORT>;
    keepalive 16;
}

# Límite básico por IP para rutas sensibles (ajustar tras medir tráfico real).
limit_req_zone $binary_remote_addr zone=javis_sensitive:10m rate=10r/m;

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN> www.<DOMAIN>;

    # Necesario si se usa Certbot con el método webroot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://<DOMAIN>$request_uri;
    }
}

# www → dominio canónico
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.<DOMAIN>;
    ssl_certificate     <CERT_PATH>;
    ssl_certificate_key <KEY_PATH>;
    return 301 https://<DOMAIN>$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <DOMAIN>;

    ssl_certificate     <CERT_PATH>;
    ssl_certificate_key <KEY_PATH>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Tamaño máximo de petición (subida de imágenes del panel). Ajustar al límite definido en la app.
    client_max_body_size 10m;

    # Archivos ocultos (.env, .git, etc.): nunca se sirven.
    location ~ /\. {
        deny all;
        return 404;
    }

    # Imágenes públicas desde el almacenamiento persistente.
    # Solo extensiones de imagen permitidas; sin listado de directorios ni ejecución.
    location /media/ {
        alias <STORAGE_PUBLIC_DIR>/;
        autoindex off;
        location ~* \.(?:jpe?g|png|webp|avif|gif)$ {
            add_header Cache-Control "public, max-age=2592000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
        }
        return 404;
    }

    # Recursos estáticos compilados de Next.js (con hash en el nombre).
    location /_next/static/ {
        proxy_pass http://javis_web;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Webhooks de pago: el cuerpo debe llegar intacto para verificar la firma.
    # (Ruta prevista, todavía no implementada.)
    location /api/v1/webhooks/ {
        proxy_pass http://javis_web;
        proxy_request_buffering off;
        include /etc/nginx/snippets/javis-proxy-headers.conf;
    }

    # Inicio de sesión del panel: límite de solicitudes adicional. (Ruta prevista.)
    location /admin/login {
        limit_req zone=javis_sensitive burst=5 nodelay;
        proxy_pass http://javis_web;
        include /etc/nginx/snippets/javis-proxy-headers.conf;
    }

    location / {
        proxy_pass http://javis_web;
        include /etc/nginx/snippets/javis-proxy-headers.conf;
    }

    access_log /var/log/nginx/javis-market.access.log;
    error_log  /var/log/nginx/javis-market.error.log warn;
}
