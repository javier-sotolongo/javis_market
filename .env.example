# =============================================================================
# Javis Market — variables de entorno
# -----------------------------------------------------------------------------
# Desarrollo: copia este archivo a `.env` en la raíz del repositorio.
# Producción: crea el archivo FUERA del repositorio (p. ej. <ENV_FILE_PATH>) con
#             permisos 600 y apúntalo con JAVIS_ENV_FILE al arrancar PM2
#             (ver infra/pm2/ecosystem.config.cjs y docs/deployment.md).
# Nunca versiones valores reales. Todos los valores de abajo son marcadores.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# development | test | production
APP_ENV=development
# URL pública canónica de la tienda (dominio pendiente de Marco).
PUBLIC_SITE_URL=http://localhost:3000
# Puerto interno en el que escucha Next.js (Nginx hace de proxy en producción).
PORT=3000
# Solo producción: directorio de logs de PM2 (fuera del repositorio).
# LOG_DIR=<LOG_DIR>

# --- Base de datos (PostgreSQL) ----------------------------------------------
# Usuario de aplicación con privilegios mínimos sobre su propia base de datos.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>?schema=public
# Con el PostgreSQL local de desarrollo (`npm run dev:all` / scripts/dev-db.sh), solo para tu equipo:
# DATABASE_URL=postgresql://javis:javis_dev@localhost:5433/javis_market?schema=public
# Conexiones máximas del pool por proceso (web y worker tienen el suyo). Por defecto 10.
# DATABASE_POOL_MAX=10

# Solo desarrollo: bases de datos de pruebas. Su nombre DEBE contener "test"; las pruebas las vacían.
# TEST_DATABASE_URL=postgresql://javis:javis_dev@localhost:5433/javis_market_test?schema=public
# E2E_DATABASE_URL=postgresql://javis:javis_dev@localhost:5433/javis_market_e2e_test?schema=public

# --- Almacenamiento de archivos ----------------------------------------------
# Imágenes públicas (servidas por Nginx en /media/). Fuera del repositorio en producción.
STORAGE_PUBLIC_DIR=./storage/public
# Documentos privados: NUNCA servidos directamente por Nginx.
STORAGE_PRIVATE_DIR=./storage/private
# URL base pública de las imágenes (ruta relativa al mismo dominio o URL absoluta).
PUBLIC_MEDIA_BASE_URL=/media
# Opcional: dominios desde los que se permite importar imágenes por URL, separados por comas
# (admite comodín inicial, p. ej. "*.deliflow.com"). Vacío = cualquier dominio público.
IMAGE_IMPORT_ALLOWED_HOSTS=

# --- Invello (catálogo del proveedor, ADR 0008) -------------------------------
# API key de solo lectura que crea el proveedor en Invello. Vacío = integración desactivada.
# Solo servidor: nunca en variables NEXT_PUBLIC_*. Si IMAGE_IMPORT_ALLOWED_HOSTS tiene valor, debe incluir
# app.invello.com y api.invello.com para poder descargar las fotos.
INVELLO_API_KEY=
# Opcional: URL base de la API (por defecto https://api.invello.com/api/public/v1).
# INVELLO_API_BASE_URL=

# --- Sesiones administrativas -----------------------------------------------
# Secreto aleatorio largo para firmar las sesiones (Better Auth): `openssl rand -base64 48`.
# Obligatorio para iniciar sesión en el panel; cambiarlo invalida todas las sesiones.
AUTH_SECRET=

# --- Pagos (propuesta: Stripe, sujeta a cambios) ----------------------------
# Proveedor activo del adaptador de pagos. Vacío = pagos deshabilitados.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Correo (proveedor SMTP pendiente) ---------------------------------------
# Proveedor activo del adaptador de correo. Vacío = correos desactivados (se registran en log).
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Javis Market <no-reply@<DOMAIN>>"
