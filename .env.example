# =============================================================================
# Javis Market — variables de entorno
# -----------------------------------------------------------------------------
# Desarrollo: copia este archivo a `.env` en la raíz del repositorio.
# Producción: crea el archivo FUERA del repositorio (p. ej. <ENV_FILE_PATH>) con
#             permisos 600 y apúntalo con JAVIS_ENV_FILE al arrancar PM2
#             (ver infra/pm2/ecosystem.config.cjs y docs/deployment.md).
# Nunca versiones valores reales. Todos los valores de abajo son marcadores.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# development | test | production
APP_ENV=development
# URL pública canónica de la tienda (dominio pendiente de Marco).
PUBLIC_SITE_URL=http://localhost:3000
# Puerto interno en el que escucha Next.js (Nginx hace de proxy en producción).
PORT=3000
# Solo producción: directorio de logs de PM2 (fuera del repositorio).
# LOG_DIR=<LOG_DIR>

# --- Base de datos (PostgreSQL) ----------------------------------------------
# Usuario de aplicación con privilegios mínimos sobre su propia base de datos.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>?schema=public

# --- Almacenamiento de archivos ----------------------------------------------
# Imágenes públicas (servidas por Nginx en /media/). Fuera del repositorio en producción.
STORAGE_PUBLIC_DIR=./storage/public
# Documentos privados: NUNCA servidos directamente por Nginx.
STORAGE_PRIVATE_DIR=./storage/private
# URL base pública de las imágenes.
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media

# --- Sesiones administrativas -----------------------------------------------
# Secreto aleatorio largo (p. ej. `openssl rand -base64 48`). Pendiente: la librería
# de autenticación se seleccionará antes de implementarla (docs/security.md).
AUTH_SECRET=

# --- Pagos (propuesta: Stripe, sujeta a cambios) ----------------------------
# Proveedor activo del adaptador de pagos. Vacío = pagos deshabilitados.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Correo (proveedor SMTP pendiente) ---------------------------------------
# Proveedor activo del adaptador de correo. Vacío = correos desactivados (se registran en log).
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Javis Market <no-reply@<DOMAIN>>"
